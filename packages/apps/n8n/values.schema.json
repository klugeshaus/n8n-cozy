    "image": {
      "description": "n8n main container image. n8n 2.16.0 or newer is required for the Code Sandbox (sandbox service) integration.",
      "type": "object",
      "default": {},
      "properties": {
        "repository": {
          "description": "Image repository.",
          "type": "string",
          "default": "docker.n8n.io/n8nio/n8n"
        },
        "tag": {
          "description": "Image tag. n8n >= 2.16.0 is required when the Code Sandbox is enabled.",
          "type": "string",
          "default": "2.48.5"
        }
      }
