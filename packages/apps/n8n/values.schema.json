    "communityPackages": {
      "description": "JSON array of npm community packages reconciled by n8n on startup, e.g. [{\"name\":\"n8n-nodes-searxng\",\"version\":\"0.2.6\"}]. Requires egress to the npm registry. Leave empty to install nodes from the n8n UI instead.",
      "type": "string",
      "default": ""
    },
    "sandbox": {
      "description": "Code Sandbox: optional n8n sandbox service (API + Sysbox runners) for the Code node and AI agent tooling. Disabled by default.",
      "type": "object",
      "default": {},
      "properties": {
        "enabled": {
          "description": "Deploy the sandbox service API and runners and point n8n at it.",
          "type": "boolean",
          "default": false
        },
        "apiKey": {
          "description": "Admin API key shared with the sandbox API. Empty generates one and preserves it across upgrades. The same value is written to SANDBOX_API_KEYS and to n8n N8N_SANDBOX_SERVICE_API_KEY, so the two can never drift.",
          "type": "string",
          "default": ""
        },
        "runnerRegistrationToken": {
          "description": "Token the runners use to register with the API. Empty generates one and preserves it across upgrades.",
          "type": "string",
          "default": ""
        },
        "external": {
          "description": "External sandbox service: when enabled the chart renders no in-cluster sandbox resources and points n8n at a sandbox API running elsewhere (e.g. the Cozystack VM in deploy/sandbox-vm). Disabled by default.",
          "type": "object",
          "default": {},
          "properties": {
            "enabled": {
              "description": "Use an external sandbox API instead of deploying the sandbox service in this instance.",
              "type": "boolean",
              "default": false
            },
            "url": {
              "description": "Base URL of the external sandbox API, reachable from n8n over plain HTTP, e.g. http://10.244.1.50:8080.",
              "type": "string",
              "default": ""
            },
            "apiKey": {
              "description": "API key for the external sandbox API. Must match a value in the external service SANDBOX_API_KEYS.",
              "type": "string",
              "default": ""
            }
          }
        },
